APP_NAME=Stocks
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# https mode of development for phones in the LAN, see documentation/SETUP.md
# DEV_HTTPS=true
# APP_FORCE_HTTPS=true
# to open the app from other devices in the network: APP_URL with the ip of this machine (also used by vite)
APP_FORCE_HTTPS=false

APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=de_DE
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# secret for the setup wizard (/setup) of a new instance
SETUP_TOKEN=
# reject passwords from known data leaks (asks haveibeenpwned.com)
CHECK_LEAKED_PASSWORDS=false

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=stocks
# own user, the MariaDB image does not accept "root" as user (docker-compose.sail.yaml)
DB_USERNAME=stocks
DB_PASSWORD=secret

CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# photos of items always lie on S3; the MinIO of docker-compose(.sail).yaml uses these values
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin123
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=stocks
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

REDIS_MODE=single
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=stocks@example.com
MAIL_FROM_NAME="${APP_NAME}"

OCTANE_HTTPS=false
OCTANE_WORKERS=4
OCTANE_MAX_REQUESTS=512
OCTANE_SERVER=swoole
